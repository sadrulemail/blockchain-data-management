# Copy to .env and fill DATALEDGER_MASTER_KEYS (uv run dataledger keygen).
DATALEDGER_RPC_URL=http://127.0.0.1:8545
DATALEDGER_DEPLOYMENT_FILE=../contracts/deployments/31337.json
DATALEDGER_DATABASE_URL=sqlite:///./var/dataledger.db
DATALEDGER_OBJECT_STORE_DIR=./var/objects
DATALEDGER_API_URL=http://127.0.0.1:8000
DATALEDGER_DIRECTORY_FILE=../datasets/directory.json

# Key-encryption keys, newest first: kid:base64key[,kid:base64key]
DATALEDGER_MASTER_KEYS=

# Anvil account #1, a public development key that only works on a local chain.
# It holds GATEWAY_ROLE so every read is logged on-chain. Use a managed signer (KMS/HSM) elsewhere.
DATALEDGER_GATEWAY_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d
