# Copy to .env and fill DATALEDGER_MASTER_KEYS (uv run dataledger keygen). Every setting is optional unless noted.

# Chain
DATALEDGER_RPC_URL=http://127.0.0.1:8545
DATALEDGER_DEPLOYMENT_FILE=../contracts/deployments/31337.json
# Anvil account #1, a public development key that only works on a local chain. It holds GATEWAY_ROLE, so every
# read is logged on-chain, and it pays gas for relayed (gasless) access requests. Use a managed signer elsewhere.
DATALEDGER_GATEWAY_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d
DATALEDGER_INDEXER_CONFIRMATIONS=0

# Read models: SQLite here; postgresql+psycopg://user:password@host:5432/dataledger anywhere else.
DATALEDGER_DATABASE_URL=sqlite:///./var/dataledger.db
DATALEDGER_AUTO_MIGRATE=true

# Object store: local | s3. For s3 set the bucket; credentials come from the standard AWS chain (env, profile,
# instance or pod identity). DATALEDGER_S3_ENDPOINT_URL points at an S3-compatible service.
DATALEDGER_OBJECT_STORE=local
DATALEDGER_OBJECT_STORE_DIR=./var/objects
# DATALEDGER_S3_BUCKET=
# DATALEDGER_S3_PREFIX=objects
# DATALEDGER_S3_REGION=
# DATALEDGER_S3_ENDPOINT_URL=

# Key-encryption keys, newest first: kid:base64key[,kid:base64key]
DATALEDGER_MASTER_KEYS=

# API
DATALEDGER_API_URL=http://127.0.0.1:8000
DATALEDGER_DIRECTORY_FILE=../datasets/directory.json
DATALEDGER_AUTH_MAX_AGE_SECONDS=300
# DATALEDGER_CORS_ORIGINS=https://console.example.com
DATALEDGER_RELAY_ENABLED=true
DATALEDGER_RELAY_MAX_PER_HOUR=60
DATALEDGER_RUN_INDEXER=true

# Operations
DATALEDGER_LOG_FORMAT=text
DATALEDGER_LOG_LEVEL=INFO
# OpenTelemetry tracing (needs the `otel` extra): standard OTEL_* variables, for example
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=dataledger-api
