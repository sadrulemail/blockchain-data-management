flowchart LR
  subgraph Actors
    PUB[Publishers<br/>owners and stewards]
    CON[Consumers<br/>wallets and smart accounts]
    AUD[Quality auditors]
    ANY[Anyone<br/>verifying data]
  end
  subgraph Chain["EVM chain"]
    DR[DataRegistry<br/>datasets, versions, lineage]
    AL[AccessLedger<br/>requests, grants, read log]
    QL[QualityLedger<br/>attestations]
  end
  subgraph Service["Data service (Python)"]
    API[FastAPI gateway<br/>EIP-712 signed requests, relay]
    IDX[Event indexer<br/>own process]
    DB[(PostgreSQL<br/>read models, objects, documents)]
    OBJ[(Encrypted object store<br/>S3 or volume)]
    WEB[Web console]
  end
  subgraph Ops["Operations"]
    MON[Prometheus and Grafana]
  end
  PUB -- "register, commit, grant (tx)" --> DR
  PUB -- "upload file (signed)" --> API
  CON -- "request access (tx)" --> AL
  CON -- "gasless request, download, prove (signed)" --> API
  AUD -- "read, attest (tx)" --> QL
  ANY -- "verify file or record" --> API
  API -- "hasAccess, logAccess, requestAccessWithSig" --> AL
  API --> DR
  API --> OBJ
  API --> DB
  IDX -- "eth_getLogs" --> Chain
  IDX --> DB
  WEB --> API
  API -. "/metrics" .-> MON
  IDX -. "/metrics" .-> MON
